@model IEnumerable<ElectronicsWareHouse.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-seam-fill me-2"></i>Products Management</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Create New Product
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>SKU</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center">Threshold</th>
                        <th style="width: 210px;" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <em>No products found. Click "Create New Product" to add one.</em>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            bool isLowStock = product.StockQuantity <= product.LowStockThreshold;
                            <tr>
                                <td><span class="badge bg-secondary">#@product.ProductID</span></td>
                                <td><code>@product.SKU</code></td>
                                <td class="fw-semibold">@product.ProductName</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @product.Category?.CategoryName
                                    </span>
                                </td>
                                <td class="text-end fw-bold">@product.UnitPrice.ToString("C")</td>
                                <td class="text-center">
                                    @if (isLowStock)
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@product.StockQuantity (Low)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-2 py-1">
                                            @product.StockQuantity
                                        </span>
                                    }
                                </td>
                                <td class="text-center text-muted">@product.LowStockThreshold</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@product.ProductID" class="btn btn-outline-warning">
                                            Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@product.ProductID" class="btn btn-outline-info">
                                            Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@product.ProductID" class="btn btn-outline-danger">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>