@model ElectronicsWareHouse.Models.Product

@{
    ViewData["Title"] = "Delete Product";
    bool hasTransactions = (Model.PurchaseItems != null && Model.PurchaseItems.Any()) || (Model.SaleItems != null && Model.SaleItems.Any());
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Product Confirmation</h4>
            </div>
            <div class="card-body">
                @if (hasTransactions)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-octagon me-2"></i>
                        <strong>Warning:</strong> This product has existing transaction records (@(Model.PurchaseItems?.Count ?? 0) Purchases, @(Model.SaleItems?.Count ?? 0) Sales). It cannot be deleted.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        Are you sure you want to permanently delete this product?
                    </div>
                }

                <dl class="row mt-3">
                    <dt class="col-sm-4">Product ID:</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary">#@Model.ProductID</span></dd>

                    <dt class="col-sm-4">SKU Code:</dt>
                    <dd class="col-sm-8"><code>@Model.SKU</code></dd>

                    <dt class="col-sm-4">Product Name:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.ProductName</dd>

                    <dt class="col-sm-4">Category:</dt>
                    <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "N/A")</dd>

                    <dt class="col-sm-4">Stock Quantity:</dt>
                    <dd class="col-sm-8">@Model.StockQuantity Units</dd>
                </dl>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="ProductID" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger" @(hasTransactions ? "disabled" : "")>
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>