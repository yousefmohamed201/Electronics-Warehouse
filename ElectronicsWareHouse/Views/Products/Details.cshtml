@model ElectronicsWareHouse.Models.Product

@{
    ViewData["Title"] = "Product Details";
    bool isLowStock = Model.StockQuantity <= Model.LowStockThreshold;
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-info-circle me-2"></i>Product Details: @Model.ProductName</h4>
                <span class="badge bg-dark">ID: #@Model.ProductID</span>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">SKU Code:</dt>
                    <dd class="col-sm-8"><code>@Model.SKU</code></dd>

                    <dt class="col-sm-4">Product Name:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.ProductName</dd>

                    <dt class="col-sm-4">Category:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-light text-dark border">
                            @(Model.Category?.CategoryName ?? "N/A")
                        </span>
                    </dd>

                    <dt class="col-sm-4">Unit Price:</dt>
                    <dd class="col-sm-8 fs-5 text-primary fw-bold">@Model.UnitPrice.ToString("C")</dd>

                    <dt class="col-sm-4">Stock Quantity:</dt>
                    <dd class="col-sm-8">
                        @if (isLowStock)
                        {
                            <span class="badge bg-danger text-white px-2 py-1 fs-6">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.StockQuantity (Low Stock)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success px-2 py-1 fs-6">
                                @Model.StockQuantity Units
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-4">Low Stock Threshold:</dt>
                    <dd class="col-sm-8 text-muted">@Model.LowStockThreshold Units</dd>
                </dl>

                <div class="d-flex justify-content-between border-top pt-3">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-warning me-2">
                            <i class="bi bi-pencil me-1"></i> Edit Product
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.ProductID" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>