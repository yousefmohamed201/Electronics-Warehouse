@model IEnumerable<ElectronicsWareHouse.Models.Product>

@{
    ViewData["Title"] = $"{ViewBag.SupplierName} - Product Catalog";
    var productList = Model?.ToList() ?? new List<ElectronicsWareHouse.Models.Product>();
}

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-xs">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary text-decoration-none">Suppliers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Catalog</li>
                </ol>
            </nav>
            <h1 class="page-title mb-1">
                <i class="bi bi-boxes me-2 text-primary"></i>Supplied Products Catalog
            </h1>
            <p class="text-secondary text-sm mb-0">Active inventory lines delivered and fulfilled by <strong>@ViewBag.SupplierName</strong>.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Purchases" asp-action="Create" class="ew-btn ew-btn-primary">
                <i class="bi bi-cart-plus me-1"></i>New Purchase Order
            </a>
            <a asp-action="Index" class="ew-btn ew-btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Suppliers
            </a>
        </div>
    </div>

    <!-- Product Catalog Card -->
    <div class="ew-card">
        <div class="ew-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-collection text-primary"></i>
                <span class="fw-semibold">Sourced Merchandise Catalog</span>
                <span class="ew-badge ew-badge-info ms-2">@productList.Count Items</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 250px;">
                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                    <input type="text" id="supplierProductsSearch" class="form-control border-start-0" placeholder="Filter items..." onkeyup="filterSupplierProducts()" />
                </div>
            </div>
        </div>

        @if (productList.Any())
        {
            <div class="table-responsive">
                <table class="table ew-table align-middle mb-0" id="supplierProductsTable">
                    <thead>
                        <tr>
                            <th style="width: 140px;">SKU</th>
                            <th>Product Information</th>
                            <th>Category</th>
                            <th class="text-end" style="width: 140px;">Unit Price</th>
                            <th class="text-center" style="width: 140px;">Warehouse Stock</th>
                            <th class="text-end" style="width: 100px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in productList)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace text-xs text-secondary fw-semibold">
                                        @product.SKU
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 rounded bg-light border text-primary">
                                            <i class="bi bi-cpu"></i>
                                        </div>
                                        <div>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID" class="fw-semibold text-main text-decoration-none hover-primary">
                                                @product.ProductName
                                            </a>
                                            <div class="text-xs text-secondary font-monospace">Product ID #@product.ProductID</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="ew-badge ew-badge-info text-xs">
                                        @(product.Category?.CategoryName ?? "Unassigned")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="font-monospace fw-semibold text-main">
                                        $@product.UnitPrice.ToString("N2")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (product.StockQuantity <= 0)
                                    {
                                        <span class="ew-badge ew-badge-danger">
                                            <i class="bi bi-x-circle me-1"></i>Out of Stock (0)
                                        </span>
                                    }
                                    else if (product.StockQuantity <= product.LowStockThreshold)
                                    {
                                        <span class="ew-badge ew-badge-warning">
                                            <i class="bi bi-exclamation-circle me-1"></i>@product.StockQuantity pcs (Low)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="ew-badge ew-badge-success">
                                            <i class="bi bi-check-circle me-1"></i>@product.StockQuantity pcs
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID" class="ew-btn ew-btn-secondary btn-sm p-1 px-2" title="Product Dossier">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ew-card-body text-center py-5">
                <div class="p-4 rounded-circle bg-light d-inline-flex mb-3 text-secondary">
                    <i class="bi bi-box-seam fs-1"></i>
                </div>
                <h5 class="fw-semibold text-main">No catalog products found</h5>
                <p class="text-secondary text-sm mb-4">No inventory products have been assigned to @ViewBag.SupplierName yet.</p>
                <a asp-controller="Products" asp-action="Create" class="ew-btn ew-btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Add New Product
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterSupplierProducts() {
            const query = document.getElementById("supplierProductsSearch").value.toLowerCase();
            const rows = document.querySelectorAll("#supplierProductsTable tbody tr");

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(query) ? "" : "none";
            });
        }
    </script>
}