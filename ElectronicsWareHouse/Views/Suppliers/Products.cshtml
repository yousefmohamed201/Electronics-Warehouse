@{
}
@model IEnumerable<ElectronicsWareHouse.Models.Product>

@{
    ViewData["Title"] = "Supplier Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Supplier Products</h2>
        <p class="text-muted">
            Products supplied by @ViewBag.SupplierName
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i>
        Back to Suppliers
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.SKU</td>

                                <td>
                                    @product.ProductName
                                </td>

                                <td>
                                    @product.Category?.CategoryName
                                </td>

                                <td>
                                    @product.UnitPrice.ToString("N2")
                                </td>

                                <td>
                                    @product.StockQuantity
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No supplied products found for this supplier.
            </div>
        }

    </div>
</div>