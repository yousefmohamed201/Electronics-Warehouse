@model IEnumerable<ElectronicsWareHouse.Models.Supplier>

@{
    ViewData["Title"] = "Supplier Directory";
    var supplierList = Model?.ToList() ?? new List<ElectronicsWareHouse.Models.Supplier>();
}

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="page-title mb-1">
                <i class="bi bi-building me-2 text-primary"></i>Supplier Partners
            </h1>
            <p class="text-secondary text-sm mb-0">Manage certified electronics vendors, procurement contacts, and product supply catalogs.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="ew-btn ew-btn-primary">
                <i class="bi bi-plus-lg me-1"></i>New Supplier Partner
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3">
        <div class="col-sm-6 col-xl-4">
            <div class="kpi-card">
                <div class="kpi-icon primary">
                    <i class="bi bi-buildings"></i>
                </div>
                <div class="kpi-label">Registered Suppliers</div>
                <div class="kpi-value">@supplierList.Count</div>
                <div class="text-xs text-secondary mt-1">Authorized supply vendors</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="kpi-card">
                <div class="kpi-icon success">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="kpi-label">Active Supply Contracts</div>
                <div class="kpi-value">@supplierList.Count</div>
                <div class="text-xs text-secondary mt-1">Verified direct vendor relations</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="kpi-card">
                <div class="kpi-icon info">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="kpi-label">Procurement Orders</div>
                <div class="kpi-value">Active</div>
                <div class="text-xs text-secondary mt-1">Ready for Purchase Order creation</div>
            </div>
        </div>
    </div>

    <!-- Directory Card -->
    <div class="ew-card">
        <div class="ew-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people text-primary"></i>
                <span class="fw-semibold">Vendor Partner Directory</span>
                <span class="ew-badge ew-badge-info ms-2">@supplierList.Count Partners</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 250px;">
                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                    <input type="text" id="supplierSearchInput" class="form-control border-start-0" placeholder="Search partners..." onkeyup="filterSupplierTable()" />
                </div>
            </div>
        </div>

        @if (supplierList.Any())
        {
            <div class="table-responsive">
                <table class="table ew-table align-middle mb-0" id="supplierTable">
                    <thead>
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th>Company / Partner</th>
                            <th>Key Contact</th>
                            <th>Phone & Email</th>
                            <th>Location / Address</th>
                            <th class="text-center" style="width: 140px;">Supply Catalog</th>
                            <th style="width: 150px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in supplierList)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace text-xs text-secondary">#@supplier.SupplierID</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-3 p-2 bg-light border text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-building fs-6"></i>
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@supplier.SupplierID" class="fw-semibold text-main text-decoration-none hover-primary">
                                                @supplier.SupplierName
                                            </a>
                                            <div class="text-xs text-secondary">Verified Supplier</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(supplier.ContactName))
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-person text-secondary"></i>
                                            <span class="text-sm fw-medium text-main">@supplier.ContactName</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-muted">No contact named</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @if (!string.IsNullOrEmpty(supplier.Phone))
                                        {
                                            <a href="tel:@supplier.Phone" class="text-xs text-secondary text-decoration-none font-monospace">
                                                <i class="bi bi-telephone me-1 text-primary"></i>@supplier.Phone
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(supplier.Email))
                                        {
                                            <a href="mailto:@supplier.Email" class="text-xs text-secondary text-decoration-none">
                                                <i class="bi bi-envelope me-1 text-primary"></i>@supplier.Email
                                            </a>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(supplier.Address))
                                    {
                                        <span class="text-xs text-secondary d-inline-block text-truncate" style="max-width: 220px;" title="@supplier.Address">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i>@supplier.Address
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-muted">Unspecified</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Products" asp-route-id="@supplier.SupplierID" class="ew-btn ew-btn-secondary btn-sm text-xs">
                                        <i class="bi bi-boxes me-1 text-primary"></i>Catalog
                                    </a>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@supplier.SupplierID" class="ew-btn ew-btn-secondary btn-sm p-1 px-2" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@supplier.SupplierID" class="ew-btn ew-btn-secondary btn-sm p-1 px-2" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@supplier.SupplierID" class="ew-btn ew-btn-danger btn-sm p-1 px-2" title="Delete">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ew-card-body text-center py-5">
                <div class="p-4 rounded-circle bg-light d-inline-flex mb-3 text-secondary">
                    <i class="bi bi-building-x fs-1"></i>
                </div>
                <h5 class="fw-semibold text-main">No suppliers registered yet</h5>
                <p class="text-secondary text-sm mb-4">Register your first vendor partner to start sourcing inventory products.</p>
                <a asp-action="Create" class="ew-btn ew-btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Create First Supplier
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterSupplierTable() {
            const query = document.getElementById("supplierSearchInput").value.toLowerCase();
            const rows = document.querySelectorAll("#supplierTable tbody tr");

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(query) ? "" : "none";
            });
        }
    </script>
}