@model ElectronicsWareHouse.Models.Supplier

@{
    ViewData["Title"] = $"Delete Supplier - {Model.SupplierName}";
}

<div class="d-flex flex-column gap-4" style="max-width: 720px; margin: 0 auto;">
    <!-- Breadcrumb -->
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-xs">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary text-decoration-none">Suppliers</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.SupplierID" class="text-secondary text-decoration-none">@Model.SupplierName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Delete</li>
            </ol>
        </nav>
        <h1 class="page-title mb-1 text-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Supplier Partner
        </h1>
        <p class="text-secondary text-sm mb-0">Confirm deletion of vendor master profile and review dependency implications.</p>
    </div>

    <!-- Danger Notice -->
    <div class="alert alert-danger p-4 rounded-3 border-danger-subtle d-flex gap-3 align-items-start shadow-sm">
        <i class="bi bi-shield-exclamation fs-3 text-danger flex-shrink-0"></i>
        <div>
            <h6 class="fw-bold text-danger mb-1">Referential Dependency Warning</h6>
            <p class="text-sm mb-0">
                Are you sure you want to delete supplier <strong>@Model.SupplierName</strong>? This action cannot be undone. If products or purchase orders are linked to this supplier, the system may prevent removal until references are reassigned.
            </p>
        </div>
    </div>

    <!-- Summary Card -->
    <div class="ew-card border-danger-subtle">
        <div class="ew-card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">Partner Record to Remove</span>
            <span class="font-monospace text-xs text-secondary">ID #@Model.SupplierID</span>
        </div>
        <div class="ew-card-body">
            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="text-xs text-secondary text-uppercase fw-semibold d-block mb-1">Company / Vendor Name</span>
                    <div class="fw-semibold text-main">
                        <i class="bi bi-building me-1 text-secondary"></i>@Model.SupplierName
                    </div>
                </div>
                <div class="col-sm-6">
                    <span class="text-xs text-secondary text-uppercase fw-semibold d-block mb-1">Primary Representative</span>
                    <div class="text-sm text-secondary">
                        <i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(Model.ContactName) ? "None specified" : Model.ContactName)
                    </div>
                </div>
                <div class="col-sm-6">
                    <span class="text-xs text-secondary text-uppercase fw-semibold d-block mb-1">Phone Number</span>
                    <div class="font-monospace text-sm text-secondary">
                        @(string.IsNullOrEmpty(Model.Phone) ? "N/A" : Model.Phone)
                    </div>
                </div>
                <div class="col-sm-6">
                    <span class="text-xs text-secondary text-uppercase fw-semibold d-block mb-1">Commercial Email</span>
                    <div class="text-sm text-secondary">
                        @(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)
                    </div>
                </div>
            </div>
        </div>
        <div class="ew-card-body border-top bg-light-subtle d-flex justify-content-end gap-2">
            <a asp-action="Index" class="ew-btn ew-btn-secondary">
                Cancel, Keep Supplier
            </a>
            <form asp-action="Delete" method="post" class="d-inline">
                <input type="hidden" asp-for="SupplierID" />
                <button type="submit" class="ew-btn ew-btn-danger">
                    <i class="bi bi-trash3 me-1"></i>Confirm & Delete Partner
                </button>
            </form>
        </div>
    </div>
</div>