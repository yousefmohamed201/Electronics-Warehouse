@model ElectronicsWareHouse.Models.Supplier

@{
    ViewData["Title"] = $"Edit Supplier - {Model.SupplierName}";
}

<div class="d-flex flex-column gap-4" style="max-width: 800px; margin: 0 auto;">
    <!-- Header -->
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-xs">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary text-decoration-none">Suppliers</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.SupplierID" class="text-secondary text-decoration-none">@Model.SupplierName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h1 class="page-title mb-1">
            <i class="bi bi-pencil-square me-2 text-primary"></i>Update Supplier Profile
        </h1>
        <p class="text-secondary text-sm mb-0">Modify vendor coordinates, contact person, or operating headquarters address.</p>
    </div>

    <!-- Form Card -->
    <div class="ew-card">
        <div class="ew-card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-building text-primary"></i>
                <span class="fw-semibold">Edit Vendor Record</span>
            </div>
            <span class="font-monospace text-xs text-secondary">Supplier ID #@Model.SupplierID</span>
        </div>
        <div class="ew-card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="SupplierID" />

                <div class="row g-3">
                    <!-- Supplier Name -->
                    <div class="col-12">
                        <label asp-for="SupplierName" class="form-label text-xs fw-semibold text-secondary text-uppercase mb-1">
                            Company / Supplier Name <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary">
                                <i class="bi bi-building"></i>
                            </span>
                            <input asp-for="SupplierName" class="form-control border-start-0 ps-0" required />
                        </div>
                        <span asp-validation-for="SupplierName" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <!-- Contact Name -->
                    <div class="col-md-6">
                        <label asp-for="ContactName" class="form-label text-xs fw-semibold text-secondary text-uppercase mb-1">
                            Primary Contact Representative
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="ContactName" class="form-control border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="ContactName" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label text-xs fw-semibold text-secondary text-uppercase mb-1">
                            Direct Telephone Number
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary">
                                <i class="bi bi-telephone"></i>
                            </span>
                            <input asp-for="Phone" class="form-control border-start-0 ps-0 font-monospace" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-12">
                        <label asp-for="Email" class="form-label text-xs fw-semibold text-secondary text-uppercase mb-1">
                            Commercial Email Address
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <!-- Address -->
                    <div class="col-12">
                        <label asp-for="Address" class="form-label text-xs fw-semibold text-secondary text-uppercase mb-1">
                            Distribution Headquarters / Physical Address
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary align-items-start pt-2">
                                <i class="bi bi-geo-alt"></i>
                            </span>
                            <textarea asp-for="Address" class="form-control border-start-0 ps-0" rows="3"></textarea>
                        </div>
                        <span asp-validation-for="Address" class="text-danger text-xs mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="ew-btn ew-btn-secondary">
                        Cancel
                    </a>
                    <button type="submit" class="ew-btn ew-btn-primary">
                        <i class="bi bi-check2 me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}