@model ElectronicsWareHouse.Models.Category

@{
    ViewData["Title"] = Model.CategoryName + " - Products";
}

<!-- ==========================================
     HEADER & ACTION LAUNCHPAD
     ========================================== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <a asp-action="Index" class="ew-btn ew-btn-ghost ew-btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Categories
        </a>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h2 mb-0">@Model.CategoryName</h1>
            <span class="ew-badge ew-badge-neutral">
                @(Model.Products?.Count ?? 0) Products
            </span>
        </div>
        <p class="text-muted mb-0">
            @(string.IsNullOrWhiteSpace(Model.Description) 
                ? "Browse all cataloged electronic equipment belonging to this department." 
                : Model.Description)
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Products" asp-action="Create" class="ew-btn ew-btn-primary">
            <i class="bi bi-plus-circle"></i> Add Product
        </a>
    </div>
</div>

<!-- ==========================================
     DEPARTMENT PRODUCTS TABLE
     ========================================== -->
@if (Model.Products == null || !Model.Products.Any())
{
    <div class="ew-card">
        <div class="ew-empty-state">
            <div class="empty-icon-wrap"><i class="bi bi-box-seam"></i></div>
            <div class="empty-title">No Products in "@Model.CategoryName"</div>
            <p class="empty-description">
                There are currently no items cataloged under this category department.
            </p>
            <a asp-controller="Products" asp-action="Create" class="ew-btn ew-btn-primary">
                <i class="bi bi-plus-circle"></i> Add Product to Category
            </a>
        </div>
    </div>
}
else
{
    <div class="ew-table-wrapper">
        <div class="table-responsive">
            <table class="ew-table">
                <thead>
                    <tr>
                        <th>Product Specification</th>
                        <th>SKU Code</th>
                        <th>Unit Price</th>
                        <th>Stock Level</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        var isLowStock = product.StockQuantity <= product.LowStockThreshold && product.StockQuantity > 0;
                        var isOutOfStock = product.StockQuantity == 0;

                        <tr>
                            <td>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID" class="fw-bold text-decoration-none">
                                    @product.ProductName
                                </a>
                            </td>

                            <td>
                                <span class="sku-badge"><i class="bi bi-upc-scan"></i> @product.SKU</span>
                            </td>

                            <td class="font-mono fw-semibold">
                                @product.UnitPrice.ToString("N2") EGP
                            </td>

                            <td class="font-mono fw-bold">
                                @product.StockQuantity units
                            </td>

                            <td>
                                @if (isOutOfStock)
                                {
                                    <span class="ew-badge ew-badge-danger"><span class="badge-dot"></span> Out of Stock</span>
                                }
                                else if (isLowStock)
                                {
                                    <span class="ew-badge ew-badge-warning"><span class="badge-dot"></span> Low Stock</span>
                                }
                                else
                                {
                                    <span class="ew-badge ew-badge-success"><span class="badge-dot"></span> In Stock</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID" class="ew-btn ew-btn-ghost ew-btn-icon" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.ProductID" class="ew-btn ew-btn-ghost ew-btn-icon" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}