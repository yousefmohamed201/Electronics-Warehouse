@model ElectronicsWareHouse.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-info-circle me-2"></i>Category Details: @Model.CategoryName</h4>
                <span class="badge bg-dark">ID: #@Model.CategoryID</span>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Category Name:</dt>
                    <dd class="col-sm-9 fw-bold">@Model.CategoryName</dd>

                    <dt class="col-sm-3">Description:</dt>
                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                    </dd>

                    <dt class="col-sm-3">Total Products:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-primary">@(Model.Products?.Count ?? 0) Products</span>
                    </dd>
                </dl>

                <div class="d-flex justify-content-between border-top pt-3">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.CategoryID" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i> Edit Category
                    </a>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Products in this Category</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>SKU</th>
                                <th>Product Name</th>
                                <th>Unit Price</th>
                                <th>Stock</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Products == null || !Model.Products.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">
                                        No products assigned to this category yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var product in Model.Products)
                                {
                                    <tr>
                                        <td><code>@product.SKU</code></td>
                                        <td class="fw-semibold">@product.ProductName</td>
                                        <td>@product.UnitPrice.ToString("C")</td>
                                        <td>
                                            @if (product.StockQuantity <= product.LowStockThreshold)
                                            {
                                                <span class="badge bg-danger">@product.StockQuantity (Low)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@product.StockQuantity</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID" class="btn btn-sm btn-outline-info">
                                                View Product
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>