@model ElectronicsWareHouse.Models.Category

@{
    ViewData["Title"] = "Category: " + Model.CategoryName;
}

<div class="mb-4">
    <a asp-action="Index" class="ew-btn ew-btn-ghost ew-btn-sm mb-2">
        <i class="bi bi-arrow-left"></i> Back to Categories
    </a>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="h2 mb-1">@Model.CategoryName</h1>
            <p class="text-muted mb-0">Department ID: #@Model.CategoryID</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Products" asp-route-id="@Model.CategoryID" class="ew-btn ew-btn-primary">
                <i class="bi bi-box-seam"></i> View Department Products
            </a>
            <a asp-action="Edit" asp-route-id="@Model.CategoryID" class="ew-btn ew-btn-secondary">
                <i class="bi bi-pencil-square"></i> Edit Category
            </a>
            <a asp-action="Delete" asp-route-id="@Model.CategoryID" class="ew-btn ew-btn-danger">
                <i class="bi bi-trash3"></i> Delete
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="ew-card">
            <div class="ew-card-header">
                <h3 class="ew-card-title"><i class="bi bi-info-circle text-primary"></i> Category Overview</h3>
                <span class="ew-badge ew-badge-neutral">Active Department</span>
            </div>
            <div class="ew-card-body">
                <div class="mb-4">
                    <span class="text-muted small d-block mb-1">Department Scope & Description</span>
                    <p class="fs-6 text-secondary mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed scope description recorded." : Model.Description)
                    </p>
                </div>

                <div class="pt-3 border-top" style="border-color: var(--border-subtle) !important;">
                    <a asp-action="Products" asp-route-id="@Model.CategoryID" class="ew-btn ew-btn-outline">
                        <i class="bi bi-boxes"></i> Browse Cataloged Items in this Department &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="danger-zone-card">
            <h5 class="text-danger fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill"></i> Danger Zone</h5>
            <p class="small text-secondary mb-3">
                Removing this category will be blocked if products are actively linked to it.
            </p>
            <a asp-action="Delete" asp-route-id="@Model.CategoryID" class="ew-btn ew-btn-danger ew-btn-sm w-100">
                Delete Category
            </a>
        </div>
    </div>
</div>

