@model IEnumerable<ElectronicsWareHouse.Models.Category>

@{
    ViewData["Title"] = "Inventory Categories";
}

<!-- ==========================================
     PAGE HEADER & ACTIONS
     ========================================== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Product Categories</h1>
        <p class="text-muted mb-0">
            Structure and classify warehouse electronics into departments for streamlined inventory tracking.
        </p>
    </div>

    <a asp-action="Create" class="ew-btn ew-btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Category
    </a>
</div>

<!-- ==========================================
     CATEGORY CARDS GRID
     ========================================== -->
@if (!Model.Any())
{
    <div class="ew-card">
        <div class="ew-empty-state">
            <div class="empty-icon-wrap"><i class="bi bi-tags"></i></div>
            <div class="empty-title">No Categories Found</div>
            <p class="empty-description">
                Organize your electronics warehouse by establishing department categories.
            </p>
            <a asp-action="Create" class="ew-btn ew-btn-primary">
                <i class="bi bi-plus-circle"></i> Add First Category
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            var productCount = item.Products?.Count ?? 0;

            <div class="col-md-6 col-xl-4">
                <div class="category-card">
                    
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="category-icon-box">
                            <i class="bi bi-folder2-open"></i>
                        </div>
                        <span class="ew-badge ew-badge-neutral font-mono">
                            <i class="bi bi-box-seam"></i> @productCount items
                        </span>
                    </div>

                    <h3 class="h4 mb-2">
                        <a asp-action="Products" asp-route-id="@item.CategoryID" class="text-decoration-none text-primary fw-bold">
                            @item.CategoryName
                        </a>
                    </h3>

                    <p class="text-muted small mb-4 flex-grow-1" style="min-height: 40px;">
                        @(string.IsNullOrWhiteSpace(item.Description) 
                            ? "No detailed description registered for this classification department." 
                            : item.Description)
                    </p>

                    <div class="d-flex align-items-center justify-content-between pt-3 border-top" style="border-color: var(--border-subtle) !important;">
                        <a asp-action="Products" asp-route-id="@item.CategoryID" class="ew-btn ew-btn-secondary ew-btn-sm">
                            <i class="bi bi-eye"></i> View Products
                        </a>

                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@item.CategoryID" class="ew-btn ew-btn-ghost ew-btn-icon" title="Edit Category">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.CategoryID" class="ew-btn ew-btn-ghost ew-btn-icon" title="Category Details">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryID" class="ew-btn ew-btn-ghost ew-btn-icon text-danger" title="Delete Category">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}