@model IEnumerable<ElectronicsWareHouse.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-tags-fill me-2"></i>Categories Management</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Create New Category
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th style="width: 140px;" class="text-center">Products Count</th>
                        <th style="width: 220px;" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <em>No categories found. Click "Create New Category" to add one.</em>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@category.CategoryID</span></td>
                                <td class="fw-semibold">@category.CategoryName</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(category.Description) ? "-" : category.Description)
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark">
                                        @(category.Products?.Count ?? 0) Products
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@category.CategoryID" class="btn btn-outline-warning">
                                            Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@category.CategoryID" class="btn btn-outline-info">
                                            Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@category.CategoryID" class="btn btn-outline-danger">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>