@model IEnumerable<ElectronicsWareHouse.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<table class="table table-dark table-hover">
    <thead>
        <tr>
            <th>
                Category
            </th>
            <th>
                Description
            </th>
            <th>
                Products
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a asp-action="Products"
                       asp-route-id="@item.CategoryID"
                       class="text-info fw-bold text-decoration-none">
                        @item.CategoryName
                    </a>
                </td>

                <td>
                    @item.Description
                </td>

                <td>
                    <a asp-action="Products"
                       asp-route-id="@item.CategoryID"
                       class="btn btn-sm btn-info">
                        View Products
                    </a>
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.CategoryID"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.CategoryID"
                       class="btn btn-sm btn-primary">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.CategoryID"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>