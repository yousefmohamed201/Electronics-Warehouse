@model ElectronicsWareHouse.Models.Purchase

@{
    ViewData["Title"] = $"Delete Purchase #{Model.PurchaseID}";
}

<div class="d-flex flex-column gap-4" style="max-width: 720px; margin: 0 auto;">
    <!-- Breadcrumb -->
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-xs">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary text-decoration-none">Purchases</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.PurchaseID" class="text-secondary text-decoration-none">PO-@Model.PurchaseID.ToString("D5")</a></li>
                <li class="breadcrumb-item active" aria-current="page">Delete</li>
            </ol>
        </nav>
        <h1 class="page-title mb-1 text-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Purchase Order
        </h1>
        <p class="text-secondary text-sm mb-0">Confirm deletion of purchase order and reversal of received stock items.</p>
    </div>

    <!-- Danger Notice -->
    <div class="alert alert-danger p-4 rounded-3 border-danger-subtle d-flex gap-3 align-items-start shadow-sm">
        <i class="bi bi-shield-exclamation fs-3 text-danger flex-shrink-0"></i>
        <div>
            <h6 class="fw-bold text-danger mb-1">Inventory Reversal Warning</h6>
            <p class="text-sm mb-0">
                Deleting this purchase order will permanently remove this financial record and <strong>deduct the received item quantities from current warehouse stock</strong>. This operation cannot be undone.
            </p>
        </div>
    </div>

    <!-- PO Summary Card -->
    <div class="ew-card border-danger-subtle">
        <div class="ew-card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">Purchase Order To Be Voided</span>
            <span class="font-monospace text-xs text-secondary">ID #@Model.PurchaseID</span>
        </div>
        <div class="ew-card-body">
            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="text-xs text-secondary text-uppercase fw-semibold d-block mb-1">Supplier Partner</span>
                    <div class="fw-semibold text-main">
                        <i class="bi bi-building me-1 text-secondary"></i>@(Model.Supplier?.SupplierName ?? "Unassigned")
                    </div>
                </div>
                <div class="col-sm-6">
                    <span class="text-xs text-secondary text-uppercase fw-semibold d-block mb-1">Order Date</span>
                    <div class="font-monospace text-sm text-main">
                        <i class="bi bi-calendar3 me-1 text-secondary"></i>@Model.PurchaseDate.ToString("yyyy-MM-dd HH:mm")
                    </div>
                </div>
                <div class="col-sm-6">
                    <span class="text-xs text-secondary text-uppercase fw-semibold d-block mb-1">Total Transaction Amount</span>
                    <div class="font-monospace fs-5 fw-bold text-danger">
                        $@Model.TotalAmount.ToString("N2")
                    </div>
                </div>
                <div class="col-sm-6">
                    <span class="text-xs text-secondary text-uppercase fw-semibold d-block mb-1">Items Included</span>
                    <div class="text-sm text-secondary">
                        @(Model.PurchaseItems?.Count ?? 0) recorded line item(s)
                    </div>
                </div>
            </div>
        </div>
        <div class="ew-card-body border-top bg-light-subtle d-flex justify-content-end gap-2">
            <a asp-action="Index" class="ew-btn ew-btn-secondary">
                Cancel, Keep Order
            </a>
            <form asp-action="Delete" method="post" class="d-inline">
                <input type="hidden" asp-for="PurchaseID" />
                <button type="submit" class="ew-btn ew-btn-danger">
                    <i class="bi bi-trash3 me-1"></i>Confirm Void & Delete
                </button>
            </form>
        </div>
    </div>
</div>