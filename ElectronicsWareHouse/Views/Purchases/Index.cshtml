@{
}
@model IEnumerable<ElectronicsWareHouse.Models.Purchase>

@{
    ViewData["Title"] = "Purchases";
}

<h1>Purchases</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        New Purchase
    </a>
</p>

<form asp-action="Index" method="get" class="row g-3 mb-4">

    <div class="col-md-4">
        <label class="form-label">Supplier</label>
        <input type="text"
               name="supplierSearch"
               value="@ViewBag.SupplierSearch"
               class="form-control"
               placeholder="Search by supplier name" />
    </div>

    <div class="col-md-3">
        <label class="form-label">From</label>
        <input type="date"
               name="fromDate"
               value="@ViewBag.FromDate"
               class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">To</label>
        <input type="date"
               name="toDate"
               value="@ViewBag.ToDate"
               class="form-control" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-secondary w-100">
            Filter
        </button>
    </div>

</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Supplier</th>
            <th>Date</th>
            <th>Total Amount</th>
            <th>Items</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var purchase in Model)
        {
            <tr>
                <td>@purchase.PurchaseID</td>

                <td>
                    @purchase.Supplier.SupplierName
                </td>

                <td>
                    @purchase.PurchaseDate.ToString("yyyy-MM-dd HH:mm")
                </td>

                <td>
                    @purchase.TotalAmount.ToString("0.00")
                </td>

                <td>
                    @purchase.PurchaseItems.Count
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@purchase.PurchaseID"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@purchase.PurchaseID"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-supplierSearch="@ViewBag.SupplierSearch"
                       asp-route-fromDate="@ViewBag.FromDate"
                       asp-route-toDate="@ViewBag.ToDate">
                        @i
                    </a>
                </li>
            }

        </ul>
    </nav>
}