@{
}
@model ElectronicsWareHouse.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<h1>Sale Details</h1>

<div class="card mb-4">

    <div class="card-body">

        <h4>Sale #@Model.SaleID</h4>

        <p>
            <strong>Date:</strong>
            @Model.SaleDate.ToString("yyyy-MM-dd HH:mm")
        </p>

        <p>
            <strong>Customer:</strong>
            @(string.IsNullOrEmpty(Model.CustomerInfo)
                ? "Walk-in Customer"
                : Model.CustomerInfo)
        </p>

        <p>
            <strong>Total:</strong>
            @Model.TotalAmount.ToString("0.00")
        </p>

    </div>

</div>


<h4>Sale Items</h4>

<table class="table table-bordered">

    <thead>

        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.SaleItems)
        {
            <tr>

                <td>
                    @item.Product.ProductName
                </td>

                <td>
                    @item.Quantity
                </td>

                <td>
                    @item.UnitPrice.ToString("0.00")
                </td>

                <td>
                    @(
                        (item.Quantity * item.UnitPrice)
                        .ToString("0.00")
                    )
                </td>

            </tr>
        }

    </tbody>

</table>


<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>