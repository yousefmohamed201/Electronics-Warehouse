@model ElectronicsWareHouse.ViewModels.AIViewModel

@{
    ViewData["Title"] = "AI Inventory Copilot";
}

<div class="d-flex flex-column gap-4" style="max-width: 960px; margin: 0 auto;">
    <!-- Copilot Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="ew-badge ew-badge-info text-xs">
                    <i class="bi bi-stars me-1 text-primary"></i>Powered by Gemini 2.5
                </span>
                <span class="ew-badge ew-badge-success text-xs">
                    <i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i>Online
                </span>
            </div>
            <h1 class="page-title mb-1">
                <i class="bi bi-robot me-2 text-primary"></i>Gemini Inventory Copilot
            </h1>
            <p class="text-secondary text-sm mb-0">Ask deep natural language questions regarding stock depletion, sales velocity, reorder logistics, and SKU telemetry.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Dashboard" asp-action="Index" class="ew-btn ew-btn-secondary">
                <i class="bi bi-speedometer2 me-1"></i>Warehouse Telemetry
            </a>
        </div>
    </div>

    <!-- Suggested Quick Prompts -->
    <div class="ew-card bg-light-subtle border-0">
        <div class="ew-card-body p-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-lightbulb text-warning"></i>
                <span class="text-xs fw-bold text-uppercase text-secondary">Quick Query Prompts</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="ew-btn ew-btn-secondary btn-sm prompt-chip text-xs" onclick="setPrompt('Which products are currently at or below minimum threshold and require immediate reorder?')">
                    <i class="bi bi-exclamation-triangle text-warning me-1"></i>Low stock items to reorder
                </button>
                <button type="button" class="ew-btn ew-btn-secondary btn-sm prompt-chip text-xs" onclick="setPrompt('Analyze our top performing inventory categories and recommend stock replenishment priorities.')">
                    <i class="bi bi-graph-up-arrow text-success me-1"></i>Top categories & replenishment
                </button>
                <button type="button" class="ew-btn ew-btn-secondary btn-sm prompt-chip text-xs" onclick="setPrompt('Summarize our recent procurement spend versus sales revenue for this cycle.')">
                    <i class="bi bi-cash-stack text-primary me-1"></i>Procurement vs sales analysis
                </button>
                <button type="button" class="ew-btn ew-btn-secondary btn-sm prompt-chip text-xs" onclick="setPrompt('What are key warehouse operational metrics and best practices for electronic components storage?')">
                    <i class="bi bi-cpu text-info me-1"></i>Warehouse components storage tips
                </button>
            </div>
        </div>
    </div>

    <!-- AI Prompt Form Card -->
    <div class="ew-card shadow-sm">
        <div class="ew-card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-chat-left-text text-primary"></i>
                <span class="fw-semibold">Query Warehouse Knowledge Base</span>
            </div>
            <span class="text-xs text-secondary">Markdown & Data telemetry supported</span>
        </div>
        <div class="ew-card-body">
            <form asp-action="Index" method="post" id="aiForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Question" class="form-label text-xs fw-semibold text-secondary text-uppercase mb-1">
                        Your Inquiry
                    </label>
                    <textarea asp-for="Question"
                              id="aiQuestionInput"
                              class="form-control"
                              rows="4"
                              placeholder="e.g., Identify inventory anomalies, suggest bulk restock quantities for next week..."
                              required></textarea>
                    <span asp-validation-for="Question" class="text-danger text-xs mt-1 d-block"></span>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-2 border-top">
                    <div class="text-xs text-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle"></i>
                        <span>Queries utilize live database context regarding products, suppliers, and sales.</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="ew-btn ew-btn-secondary btn-sm" onclick="clearPrompt()">
                            Clear
                        </button>
                        <button type="submit" class="ew-btn ew-btn-primary" id="askGeminiBtn">
                            <i class="bi bi-stars me-1"></i>Ask Gemini Copilot
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Error State -->
    @if (!string.IsNullOrWhiteSpace(Model?.Error))
    {
        <div class="alert alert-danger p-4 rounded-3 border-danger-subtle d-flex gap-3 align-items-start shadow-sm">
            <i class="bi bi-shield-x fs-3 text-danger flex-shrink-0"></i>
            <div>
                <h6 class="fw-bold text-danger mb-1">Gemini Intelligence Service Notice</h6>
                <p class="text-sm mb-0">@Model.Error</p>
                <div class="text-xs text-muted mt-2">Ensure your `GeminiApiKey` is configured correctly in `appsettings.json`.</div>
            </div>
        </div>
    }

    <!-- AI Answer Output Card -->
    @if (!string.IsNullOrWhiteSpace(Model?.Answer))
    {
        <div class="ew-card border-primary-subtle shadow-sm">
            <div class="ew-card-header d-flex align-items-center justify-content-between bg-light-subtle">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle p-1 bg-primary text-white d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                        <i class="bi bi-stars text-xs"></i>
                    </div>
                    <span class="fw-semibold text-main">Gemini Synthesized Intelligence</span>
                </div>
                <button type="button" class="ew-btn ew-btn-secondary btn-sm p-1 px-2 text-xs" onclick="copyResponse()">
                    <i class="bi bi-clipboard me-1" id="copyIcon"></i><span id="copyText">Copy Output</span>
                </button>
            </div>
            <div class="ew-card-body p-4">
                <div class="ai-response-container p-3 rounded-3 bg-light border text-main" id="aiAnswerContent" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.65;">@Model.Answer</div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function setPrompt(text) {
            const input = document.getElementById("aiQuestionInput");
            if (input) {
                input.value = text;
                input.focus();
            }
        }

        function clearPrompt() {
            const input = document.getElementById("aiQuestionInput");
            if (input) {
                input.value = "";
                input.focus();
            }
        }

        function copyResponse() {
            const content = document.getElementById("aiAnswerContent");
            const copyIcon = document.getElementById("copyIcon");
            const copyText = document.getElementById("copyText");

            if (content) {
                navigator.clipboard.writeText(content.innerText).then(() => {
                    if (copyIcon && copyText) {
                        copyIcon.className = "bi bi-check2 text-success me-1";
                        copyText.textContent = "Copied!";
                        setTimeout(() => {
                            copyIcon.className = "bi bi-clipboard me-1";
                            copyText.textContent = "Copy Output";
                        }, 2000);
                    }
                });
            }
        }

        document.getElementById("aiForm")?.addEventListener("submit", function() {
            const btn = document.getElementById("askGeminiBtn");
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Consulting Gemini...';
            }
        });
    </script>
}