@model ErrorViewModel
@{
    ViewData["Title"] = "System Incident";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5" style="max-width: 680px; margin: 0 auto;">
    <div class="p-4 rounded-circle bg-danger bg-opacity-10 text-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill fs-1"></i>
    </div>
    
    <span class="ew-badge ew-badge-danger mb-2">Internal Service Exception</span>
    <h1 class="display-6 fw-bold text-main mb-2">Unexpected System Condition</h1>
    <p class="text-secondary text-sm mb-4">
        An error occurred while attempting to process your warehouse transaction or telemetry request.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="ew-card w-100 mb-4 p-3 bg-light-subtle text-start">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-xs text-secondary text-uppercase fw-semibold">Telemetry Trace ID:</span>
                <code class="font-monospace text-xs text-primary">@Model.RequestId</code>
            </div>
        </div>
    }

    <div class="d-flex gap-2">
        <a asp-controller="Dashboard" asp-action="Index" class="ew-btn ew-btn-primary">
            <i class="bi bi-speedometer2 me-1"></i>Return to Dashboard
        </a>
        <a href="javascript:location.reload()" class="ew-btn ew-btn-secondary">
            <i class="bi bi-arrow-clockwise me-1"></i>Retry Operation
        </a>
    </div>
</div>
